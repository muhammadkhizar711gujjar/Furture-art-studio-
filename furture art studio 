<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Future Art Studio</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;font-family:Arial,sans-serif;
  background:#f5fff7;color:#16351f
}
header{
  background:#0b6b35;color:white;text-align:center;
  padding:24px 12px
}
header h1{margin:0 0 8px}
header p{margin:0}
.container{max-width:1000px;margin:auto;padding:16px}
h2{color:#0b6b35}
.products{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px
}
.card{
  background:white;border:1px solid #d6e8da;
  border-radius:12px;padding:14px;
  box-shadow:0 2px 8px #0000000d
}
.card img{
  width:100%;height:180px;object-fit:contain;
  background:#f7faf7;border-radius:8px
}
button{
  border:0;border-radius:7px;padding:11px 14px;
  background:#0b6b35;color:white;font-weight:bold;
  cursor:pointer
}
button:hover{background:#084d27}
input,select,textarea{
  width:100%;padding:12px;margin:6px 0 14px;
  border:1px solid #b9cdbd;border-radius:7px;
  font-size:15px;background:white
}
label{font-weight:bold}
.panel{
  background:white;padding:18px;border-radius:12px;
  margin:20px 0;border:1px solid #d6e8da
}
.price{font-size:19px;font-weight:bold;color:#0b6b35}
.small{font-size:13px;color:#536b59}
.payment-note{
  background:#eef8ef;padding:12px;border-radius:8px;
  margin:8px 0 14px;line-height:1.6
}
.cart-row{
  display:flex;justify-content:space-between;
  gap:12px;align-items:center;padding:10px 0;
  border-bottom:1px solid #e4eee6
}
footer{
  background:#0b6b35;color:white;text-align:center;
  padding:20px;margin-top:25px
}
</style>
</head>

<body>
<header>
  <h1>Future Art Studio</h1>
  <p>Creative Printing • Custom Designs • Online Services</p>
  <p>Explore Your Style With Us</p>
</header>

<main class="container">
  <section>
    <h2>Our Products</h2>
    <p id="productStatus">Loading products...</p>
    <div id="products" class="products"></div>
  </section>

  <section class="panel">
    <h2>Shopping Cart</h2>
    <div id="cartItems">Your cart is empty.</div>
    <p class="price">Product Total: Rs. <span id="cartTotal">0</span></p>
    <button type="button" onclick="clearCart()">Clear Cart</button>
  </section>

  <section class="panel">
    <h2>Place Your Order</h2>

    <form id="orderForm">
      <label for="customerName">Full Name</label>
      <input id="customerName" required placeholder="Enter your full name">

      <label for="phone">Phone Number</label>
      <input id="phone" required type="tel" placeholder="03XXXXXXXXX">

      <label for="address">Complete Delivery Address</label>
      <textarea id="address" required rows="3"
        placeholder="House, street, city and district"></textarea>

      <label for="courier">Select Courier Service</label>
      <select id="courier" required>
        <option value="PostEx">PostEx</option>
        <option value="TCS">TCS</option>
        <option value="Leopards Courier">Leopards Courier</option>
        <option value="Pakistan Post Office">Pakistan Post Office</option>
      </select>

      <label for="paymentOption">Payment Option</label>
      <select id="paymentOption" required onchange="updatePaymentInfo()">
        <option value="advance">Advance Delivery Payment — Rs. 250</option>
        <option value="full">Full Payment — Product + Rs. 250</option>
      </select>

      <div class="payment-note" id="paymentInfo">
        Pay Rs. 250 in advance for delivery. Pay the remaining product amount
        when your order arrives.
      </div>

      <p>Product Total: Rs. <strong id="formProductTotal">0</strong></p>
      <p>Delivery Charges: Rs. <strong>250</strong></p>
      <p class="price">Pay Now: Rs. <span id="payNow">250</span></p>
      <p id="remainingInfo" class="small"></p>

      <label for="transactionId">Payment Transaction ID / Reference</label>
      <input id="transactionId" required
        placeholder="Enter transaction reference after payment">

      <label for="notes">Order Notes (Optional)</label>
      <textarea id="notes" rows="2"
        placeholder="Size, colour or other instructions"></textarea>

      <button type="submit" id="submitOrder">Submit Order</button>
      <p id="orderStatus" role="status"></p>
      <p class="small">
        Please verify payment instructions with Future Art Studio before
        transferring money. Submitting this form does not itself make a payment.
      </p>
    </form>
  </section>
</main>

<footer>
  <strong>Future Art Studio</strong>
  <p>Thank you for choosing our business!</p>
</footer>

<script>
const API_URL =
"https://script.google.com/macros/s/AKfycbzzbWn3DmQH9ivsbQFrb1udFM-ASKAnrKlKIwYrCM1PBpdxFF_9oP8xMUnVPZzpV2H9/exec";

let products = [];
let cart = [];

function money(value) {
  return Math.round(Number(value) || 0).toLocaleString("en-PK");
}

function safeText(value) {
  return String(value ?? "").replace(/[&<>"']/g, char => ({
    "&":"&amp;", "<":"&lt;", ">":"&gt;",
    '"':"&quot;", "'":"&#39;"
  })[char]);
}

async function loadProducts() {
  const status = document.getElementById("productStatus");
  status.textContent = "Loading products...";

  try {
    const response = await fetch(API_URL);
    if (!response.ok) throw new Error("Product request failed");

    const data = await response.json();
    if (!Array.isArray(data)) {
      throw new Error("Expected a product list from Google Sheets");
    }

    products = data;
    renderProducts();
    status.textContent = products.length
      ? "Products loaded."
      : "No products found. Please check your Google Sheet.";
  } catch (error) {
    status.textContent =
      "Products could not load. Please check the Apps Script connection.";
  }
}

function renderProducts() {
  const area = document.getElementById("products");

  if (!products.length) {
    area.innerHTML = "<p>No products available right now.</p>";
    return;
  }

  area.innerHTML = products.map((p, i) => {
    const name = p["Product Name"] || "Product";
    const description = p["Description"] || "";
    const price = Number(p["Price"]) || 0;
    const image = String(p["Image URL"] || "");
    const stock = p["Stock"];
    const soldOut = stock !== "" && stock != null &&
      Number(stock) <= 0;

    return `
      <article class="card">
        <img src="${safeText(image)}"
          alt="${safeText(name)}"
          onerror="this.style.display='none'">
        <h3>${safeText(name)}</h3>
        <p>${safeText(description)}</p>
        <p class="price">Rs. ${money(price)}</p>
        <p class="small">Category: ${safeText(p["Category"] || "General")}</p>
        <button type="button" onclick="addToCart(${i})"
          ${soldOut ? "disabled" : ""}>
          ${soldOut ? "Out of Stock" : "Add to Cart"}
        </button>
      </article>`;
  }).join("");
}

function addToCart(index) {
  const p = products[index];
  if (!p) return;

  const name = p["Product Name"] || "Product";
  const price = Number(p["Price"]) || 0;
  const existing = cart.find(item => item.name === name);

  if (existing) {
    existing.quantity++;
  } else {
    cart.push({name, price, quantity:1});
  }

  renderCart();
}

function renderCart() {
  const area = document.getElementById("cartItems");

  if (!cart.length) {
    area.textContent = "Your cart is empty.";
  } else {
    area.innerHTML = cart.map((item, index) => `
      <div class="cart-row">
        <div>
          <strong>${safeText(item.name)}</strong><br>
          Rs. ${money(item.price)} × ${item.quantity}
        </div>
        <div>
          <button type="button" onclick="changeQuantity(${index},-1)">−</button>
          <button type="button" onclick="changeQuantity(${index},1)">+</button>
        </div>
      </div>`).join("");
  }

  document.getElementById("cartTotal").textContent = money(getTotal());
  document.getElementById("formProductTotal").textContent = money(getTotal());
  updatePaymentInfo();
}

function changeQuantity(index, change) {
  if (!cart[index]) return;
  cart[index].quantity += change;

  if (cart[index].quantity <= 0) {
    cart.splice(index, 1);
  }
  renderCart();
}

function clearCart() {
  cart = [];
  renderCart();
}

function getTotal() {
  return cart.reduce((sum, item) =>
    sum + item.price * item.quantity, 0);
}

function updatePaymentInfo() {
  const method = document.getElementById("paymentOption").value;
  const total = getTotal();
  const payNow = method === "advance" ? 250 : total + 250;
  const remaining = method === "advance" ? total : 0;

  document.getElementById("paymentInfo").textContent =
    method === "advance"
      ? "Advance Delivery: Pay Rs. 250 now. Pay the product amount of Rs. " +
        money(total) + " when the order arrives."
      : "Full Payment: Pay the product amount plus Rs. 250 delivery. Total: Rs. " +
        money(total + 250) + ".";

  document.getElementById("payNow").textContent = money(payNow);
  document.getElementById("remainingInfo").textContent =
    method === "advance"
      ? "Remaining amount payable on delivery: Rs. " + money(remaining)
      : "Remaining amount on delivery: Rs. 0";
}

document.getElementById("orderForm").addEventListener("submit",
  async function(event) {
    event.preventDefault();

    if (!cart.length) {
      alert("Please add at least one product to your cart.");
      return;
    }

    const button = document.getElementById("submitOrder");
    const status = document.getElementById("orderStatus");
    const method = document.getElementById("paymentOption").value;
    const total = getTotal();

    const order = {
      orderId: "FAS-" + Date.now(),
      date: new Date().toISOString(),
      customerName: document.getElementById("customerName").value.trim(),
      phone: document.getElementById("phone").value.trim(),
      address: document.getElementById("address").value.trim(),
      courier: document.getElementById("courier").value,
      paymentOption: method,
      productTotal: total,
      deliveryCharges: 250,
      payNow: method === "advance" ? 250 : total + 250,
      remainingOnDelivery: method === "advance" ? total : 0,
      transactionId: document.getElementById("transactionId").value.trim(),
      notes: document.getElementById("notes").value.trim(),
      items: cart.map(item => ({
        name: item.name,
        price: item.price,
        quantity: item.quantity
      }))
    };

    button.disabled = true;
    status.textContent = "Sending order...";

    try {
      const response = await fetch(API_URL, {
        method: "POST",
        headers: {"Content-Type":"text/plain;charset=utf-8"},
        body: JSON.stringify(order)
      });

      const result = await response.json();

      if (!response.ok || result.success === false || result.error) {
        throw new Error(result.error || "Order could not be confirmed");
      }

      status.textContent =
        "Server response received. Please verify the order in your Google Sheet.";
      alert("Order request sent. Please confirm the order with Future Art Studio.");
      clearCart();
      document.getElementById("orderForm").reset();
      updatePaymentInfo();

    } catch (error) {
      status.textContent =
        "Order could not be confirmed. Please check Apps Script and Google Sheet before trying again.";
    } finally {
      button.disabled = false;
    }
  });

renderCart();
loadProducts();
</script>
</body>
</html>